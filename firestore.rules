rules_version = '2';

// El dashboard solo lee. Solo el monitor (con la cuenta de servicio, que
// ignora estas reglas) puede escribir.
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
